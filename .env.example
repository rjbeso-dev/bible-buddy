# Optional API keys for the copyrighted ESV and NLT translations.
# Copy this file to `.env.local` and paste your own free keys. They stay on the
# server (Vite dev proxy locally, Vercel serverless function in production) and
# are never shipped to the browser. Leave them blank to run with only the free
# public-domain translations.

# Free key: https://api.esv.org/
ESV_API_KEY=

# Free key: https://api.nlt.to/
NLT_API_KEY=

# Optional accounts & cloud sync (Supabase + Google sign-in).
# Leave both blank to run fully local with no account UI at all. To enable:
# create a free project at https://supabase.com, run supabase/schema.sql in
# its SQL editor, enable the Google auth provider, then paste the values from
# Project Settings → API below. These are read in the browser (VITE_ prefix) —
# the anon key is safe to expose; Row-Level Security protects each user's data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: shows a "Signed-in users" admin page (/admin, linked from the
# account menu) to whichever email you put here — a simple list of who's
# signed in, nothing more. Leave blank to skip it entirely. This alone
# doesn't grant access — supabase/schema.sql's "admin can read the
# directory" policy has the same email hardcoded and is what actually
# enforces it; update both together if you change it.
VITE_ADMIN_EMAIL=
